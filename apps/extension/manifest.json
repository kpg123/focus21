{
  "manifest_version": 3,
  "name": "Focus21",
  "description": "Track watch time across YouTube, Twitch, and Kick. Get notified when paid surveys match your profile.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus21"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.twitch.tv/*",
    "https://twitch.tv/*",
    "https://kick.com/*",
    "https://www.kick.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.twitch.tv/*",
        "https://twitch.tv/*",
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
